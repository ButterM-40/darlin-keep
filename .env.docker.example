# Copy to .env before running docker compose.

POSTGRES_USER=vault
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=dndvault

# Host "db" is the compose service name, not localhost.
DATABASE_URL=postgresql://vault:change-me-to-something-long@db:5432/dndvault

# Real Postgres on your own box, so this can be generous.
DATABASE_POOL_MAX=10

# Optional. Posts every forge craft roll to a Discord channel. In Discord:
# channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Largest file anyone can upload, in MB.
MAX_UPLOAD_MB=50

# Where the app listens on the host. Localhost only by default, since the
# tunnel does not need it published. Use 0.0.0.0:3000 to allow your own LAN in.
APP_BIND=127.0.0.1:3000

# From the Cloudflare Zero Trust dashboard: Networks > Tunnels > your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
