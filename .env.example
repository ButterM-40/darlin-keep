# Local development. Start Postgres with:
#   docker start dnd-vault-pg
# (see the README for the one-off `docker run` that creates it)
DATABASE_URL="postgresql://vault:vault@localhost:5433/dndvault"
SHADOW_DATABASE_URL="postgresql://vault:vault@localhost:5433/dndvault_shadow"

# Where uploaded files are written. Defaults to ./uploads.
# UPLOAD_DIR=./uploads

# Optional. Posts every forge craft roll to a Discord channel. Create one in
# Discord: channel settings > Integrations > Webhooks > New Webhook > Copy URL.
# DISCORD_WEBHOOK_URL=

# Optional. Defaults to 3; see the README for why it is small.
# DATABASE_POOL_MAX=3

# For deploying to your own server with Docker, use .env.docker.example instead.
