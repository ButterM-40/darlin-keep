generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A character occupies exactly one row on each campaign's roster.
enum Status {
  ACTIVE_PARTY
  ALIVE
  DEAD
}

/// A blank fillable sheet. Uploads are immutable: revising a sheet creates a
/// new Template so existing characters keep rendering against the one they
/// were built on.
model Template {
  id         String          @id @default(cuid())
  name       String
  pdf        Bytes
  pageCount  Int
  pageSizes  Json
  fields     TemplateField[]
  characters Character[]
  createdAt  DateTime        @default(now())
}

/// One widget of one AcroForm field, with geometry already converted to a
/// CSS top-left origin so the editor can position an input directly.
model TemplateField {
  id          String   @id @default(cuid())
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  pdfName     String
  widgetIndex Int      @default(0)
  page        Int
  x           Float
  y           Float
  w           Float
  h           Float
  type        String
  options     Json?
  maxLen      Int?
  order       Int
  role        String?

  @@unique([templateId, pdfName, widgetIndex])
  @@index([templateId, order])
}

/// A member of the group. There are no logins; this is just a label.
model Owner {
  id         String      @id @default(cuid())
  name       String      @unique
  color      String?
  characters Character[]
  documents  Document[]
}

model Character {
  id             String           @id @default(cuid())
  templateId     String
  template       Template         @relation(fields: [templateId], references: [id])
  ownerId        String
  owner          Owner            @relation(fields: [ownerId], references: [id])
  /// Where the character stands is kept per campaign, on CampaignMember.
  campaigns      CampaignMember[]
  /// Denormalised from the field carrying the displayName role, for the roster.
  displayName    String
  /// Denormalised roster summary: { species, classLevel, hp, xp }.
  summary        Json
  /// The sheet itself: { [pdfFieldName]: value }.
  values         Json
  blacksmith     Blacksmith?
  notebooks      Notebook[]
  /// Optional picture for the roster card. No picture, no picture slot.
  portraitFileId String?
  portrait       StoredFile?      @relation("CharacterPortrait", fields: [portraitFileId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([ownerId])
}

/// A campaign the party plays. They all share one world, so the same
/// character can turn up in several.
model Campaign {
  id        String           @id @default(cuid())
  name      String           @unique
  members   CampaignMember[]
  documents Document[]
  createdAt DateTime         @default(now())
}

/// A character's place in one campaign. Status lives here rather than on the
/// character: someone can be out on the road in one campaign and benched in
/// another.
model CampaignMember {
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  status      Status    @default(ALIVE)
  joinedAt    DateTime  @default(now())

  @@id([campaignId, characterId])
  @@index([characterId])
}

/// What a document actually is. A PDF and a board hold uploaded bytes; a link
/// only points somewhere else.
enum DocKind {
  PDF
  LINK
  BOARD
}

/// Campaign material: handouts, maps, reference links, image boards.
model Document {
  id         String    @id @default(cuid())
  kind       DocKind
  title      String
  note       String?
  ownerId    String?
  owner      Owner?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// The campaign it belongs to, or null for material every campaign shares.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// PDF only.
  fileId    String?
  file      StoredFile? @relation(fields: [fileId], references: [id])
  pageCount Int?
  pageSizes Json?

  /// LINK only.
  url String?

  /// BOARD only.
  items BoardItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([campaignId])
}

/// Uploaded bytes. Kept behind lib/storage.ts so the backing store can change
/// to object storage without touching anything that reads or writes files.
model StoredFile {
  id         String      @id @default(cuid())
  /// Path relative to UPLOAD_DIR. Files live on disk; only metadata is in the
  /// database, so the database stays small however many images get pinned.
  storageKey String?
  /// Bytes for rows created before files moved to disk. Kept so nothing breaks
  /// mid-migration; scripts/migrate-files-to-disk.mts empties it.
  bytes      Bytes?
  mimeType   String
  size       Int
  fileName   String
  width      Int?
  height     Int?
  createdAt  DateTime    @default(now())
  documents  Document[]
  boardItems BoardItem[]
  portraits  Character[] @relation("CharacterPortrait")
}

/// One image pinned to a board, at the position and size it was left.
model BoardItem {
  id         String     @id @default(cuid())
  documentId String
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileId     String
  file       StoredFile @relation(fields: [fileId], references: [id])
  x          Float
  y          Float
  w          Float
  h          Float
  z          Int        @default(0)
  caption    String?

  @@index([documentId])
}

/// A character who works the forge. Shared by the whole party, unlike the
/// forge's house rules, which each browser keeps for itself.
model Blacksmith {
  id          String       @id @default(cuid())
  characterId String       @unique
  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  level       Int          @default(1)
  /// Crafting tokens used this week.
  tokensSpent Int          @default(0)
  /// Tokens already owed against next week, from repairs made on the road.
  tokenDebt   Int          @default(0)
  /// Ingots on hand: { [metal]: count }.
  stock       Json         @default("{}")
  /// Smithing check inputs: { str, wis, int, skill, other, mastery }.
  modifiers   Json         @default("{}")
  entries     ForgeEntry[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

/// One recorded craft or repair attempt.
model ForgeEntry {
  id           String     @id @default(cuid())
  blacksmithId String
  blacksmith   Blacksmith @relation(fields: [blacksmithId], references: [id], onDelete: Cascade)
  action       String
  result       String
  tokens       Int
  /// As shown in the history, e.g. "4 Bronze".
  ingots       String
  createdAt    DateTime   @default(now())

  @@index([blacksmithId, createdAt])
}

/// A character's own notes: session logs, NPCs, quests, anything free-form.
model Notebook {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  title       String
  body        String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([characterId, createdAt])
}

/// A theme the party saved. The built-in themes live in lib/themes.ts and are
/// never stored; everything here went through sanitizeTheme first.
model Theme {
  id        String   @id @default(cuid())
  name      String   @unique
  mood      String   @default("")
  /// "dark" or "light".
  mode      String
  /// A name from FONTS in lib/themes.ts.
  font      String
  /// { [slot]: "#rrggbb" }.
  colors    Json
  /// Optional { from: "MM-DD", to: "MM-DD" }.
  season    Json?
  /// Decoration names from EFFECTS in lib/themes.ts.
  effects   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Party-wide look. One row, id "party". Each browser may still override the
/// theme with a cookie.
model PartySettings {
  id        String  @id @default("party")
  /// A built-in theme id or a Theme.id.
  themeId   String  @default("ember-hearth")
  /// Whether a theme with a season takes over while its dates are on.
  seasonal  Boolean @default(true)
  /// How characters with a picture are drawn: avatar, banner or portrait.
  cardStyle String  @default("banner")
}
